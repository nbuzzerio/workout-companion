{
  "name": "workout-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/release.ts && python scripts/validate_artifact.py",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:infra": "python -m unittest discover -s infra/tests -v",
    "test:e2e": "playwright test",
    "test:nginx": "python infra/tests/nginx_integration.py",
    "app:config": "node scripts/config.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:infra && pnpm build && pnpm test:e2e",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.4",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.0"
  }
}
